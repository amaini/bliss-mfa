# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
PORTAL_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://bliss_mfa:change-me@postgres:5432/bliss_mfa

# Redis
REDIS_URL=redis://redis:6379/0

# Development-only bootstrap authentication
BLISS_BOOTSTRAP_API_KEY=

# Authentik / OIDC
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_GROUPS_CLAIM=groups
OIDC_STAFF_ADMIN_GROUP=bliss-mfa-super-admin
OIDC_STAFF_TECHNICIAN_GROUP=bliss-mfa-technician
OIDC_STAFF_BILLING_GROUP=bliss-mfa-billing

# multiOTP adapter
MULTIOTP_MODE=mock
MULTIOTP_ADAPTER_URL=
MULTIOTP_ADAPTER_TOKEN=

# Stripe (can remain blank until billing integration)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_PLUS=

# Never place production secrets in this file.
