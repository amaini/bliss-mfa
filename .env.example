# Root reference only. Each service has its own .env.example.

# Appliance
COMPANY_NAME=
SETUP_TOKEN=
JWT_SECRET=
MULTIOTP_ADAPTER_URL=http://multiotp-adapter:8090
MULTIOTP_ADAPTER_TOKEN=
LICENSE_AGENT_URL=http://license-agent:8091

# Local license agent
LICENSE_SERVER_URL=https://license.blissitek.ca
BLISS_SIGNING_PUBLIC_KEY_FILE=/run/bliss-keys/license-public.pem

# Bliss central licensing
ADMIN_API_KEY=
SIGNING_PRIVATE_KEY_FILE=/run/bliss-keys/license-private.pem
ONLINE_LEASE_DAYS=14
ONLINE_GRACE_DAYS=30
OFFLINE_DEFAULT_DAYS=365

# Stripe is intentionally optional until Bliss products/prices are finalized.
STRIPE_SECRET_KEY=
STRIPE_RETURN_URL=https://license.blissitek.ca/billing/return

# Never commit production secrets or the Bliss private signing key.
